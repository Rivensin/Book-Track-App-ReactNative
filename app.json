{
  "expo": {
    "name": "reactNative",
    "slug": "reactNative",
    "scheme": "booktrackapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },      
      "predictiveBackGestureEnabled": false,
      "package": "com.rivensin.reactNative"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcad8571-d72b-4a51-958d-9f2dc75c1eaa"
      }
    }
  }
}
